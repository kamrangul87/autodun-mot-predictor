# DVSA Trade API — OAuth2 client credentials
# Apply for access at: https://developer-portal.driver-vehicle-licensing.api.gov.uk
DVSA_TOKEN_URL=https://login.microsoftonline.com/YOUR_TENANT_ID/oauth2/v2.0/token
DVSA_CLIENT_ID=your-client-id-here
DVSA_CLIENT_SECRET=your-client-secret-here
DVSA_API_KEY=your-dvsa-api-key-here

# Optional — defaults are shown below
DVSA_SCOPE=https://tapi.dvsa.gov.uk/.default
DVSA_API_BASE=https://history.mot.api.gov.uk
